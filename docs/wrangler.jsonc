// Cloudflare Workers static assets: an assets-only Worker serving the documentation's pre-rendered build. Workers Builds
// runs `pnpm docs:build` from the repository root, then `npx wrangler deploy --config docs/wrangler.jsonc`. Pages are served
// at the addresses the site links to, with no trailing slash (`/components/dialog`); `/components/dialog/` redirects there.
{
	"name": "booleanpress-ui-docs",
	"compatibility_date": "2026-10-03",
	"assets": {
		"directory": "./build/client",
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	}
}
