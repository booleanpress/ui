{
    "name": "@booleanpress/ui",
    "version": "0.2.0",
    "description": "Accessible React components for Tailwind CSS 4, built on Radix: typed, documented, tested in Vite, Next.js and the WordPress admin, with a theme, a strings provider and a contrast check.",
    "keywords": [
        "react",
        "components",
        "tailwindcss",
        "radix-ui",
        "shadcn",
        "accessibility",
        "wordpress",
        "design-system"
    ],
    "license": "MIT",
    "author": "BooleanPress",
    "homepage": "https://ui.booleanpress.com",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/booleanpress/ui.git"
    },
    "bugs": {
        "url": "https://github.com/booleanpress/ui/issues"
    },
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        "./theme.css": "./theme.css",
        "./provider": {
            "types": "./dist/provider.d.ts",
            "default": "./dist/provider.js"
        },
        "./utils": {
            "types": "./dist/lib/utils.d.ts",
            "default": "./dist/lib/utils.js"
        },
        "./package.json": "./package.json",
        "./*": {
            "types": "./dist/components/*.d.ts",
            "default": "./dist/components/*.js"
        }
    },
    "bin": {
        "bui-contrast": "./bin/bui-contrast.mjs"
    },
    "files": [
        "dist",
        "src",
        "bin",
        "theme.css",
        "PATCHES.md",
        "CHANGELOG.md",
        "NOTICE"
    ],
    "scripts": {
        "dev": "react-router dev docs",
        "build": "node scripts/build.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "fixture": "node scripts/fixture.mjs",
        "check": "node scripts/check.mjs",
        "typecheck": "tsc -p tsconfig.json",
        "docs:dev": "react-router dev docs",
        "docs:build": "node scripts/docs-build.mjs",
        "docs:preview": "node scripts/docs-serve.mjs docs/build/client 5181",
        "release:first": "node scripts/publish-package.mjs",
        "release:approve": "node scripts/approve-staged.mjs",
        "check:fast": "node scripts/check.mjs --fast",
        "docs:markdown": "node --disable-warning=ExperimentalWarning scripts/docs-markdown.mjs",
        "bundle:size": "node scripts/bundle-size.mjs"
    },
    "dependencies": {
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0"
    },
    "peerDependencies": {
        "@base-ui/react": "^1.8.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@tanstack/react-table": "^9.2.5",
        "@tanstack/react-virtual": "^3.14.13",
        "@tiptap/pm": "^3.31.4",
        "@tiptap/react": "^3.31.4",
        "@tiptap/starter-kit": "^3.31.4",
        "embla-carousel-react": "^8.6.0",
        "lucide-react": ">=0.577.0 <2",
        "radix-ui": "^1.4.3",
        "react": "^19.0.0",
        "react-day-picker": "^10.0.1",
        "react-dom": "^19.0.0",
        "react-resizable-panels": "^4.14.2",
        "recharts": "^3.8.0",
        "sonner": "^2.0.7",
        "tailwindcss": "^4.1.0"
    },
    "peerDependenciesMeta": {
        "@base-ui/react": {
            "optional": true
        },
        "@dnd-kit/core": {
            "optional": true
        },
        "@dnd-kit/sortable": {
            "optional": true
        },
        "@tanstack/react-table": {
            "optional": true
        },
        "@tanstack/react-virtual": {
            "optional": true
        },
        "@tiptap/pm": {
            "optional": true
        },
        "@tiptap/react": {
            "optional": true
        },
        "@tiptap/starter-kit": {
            "optional": true
        },
        "embla-carousel-react": {
            "optional": true
        },
        "react-day-picker": {
            "optional": true
        },
        "react-resizable-panels": {
            "optional": true
        },
        "recharts": {
            "optional": true
        },
        "sonner": {
            "optional": true
        }
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@base-ui/react": "1.8.0",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "10.0.0",
        "@eslint/js": "10.0.1",
        "@fontsource-variable/geist-mono": "5.3.0",
        "@fontsource-variable/inter": "5.3.0",
        "@react-router/dev": "8.4.0",
        "@react-router/node": "8.4.0",
        "@tailwindcss/vite": "4.3.3",
        "@tanstack/react-table": "9.2.5",
        "@tanstack/react-virtual": "3.14.13",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@tiptap/pm": "3.31.4",
        "@tiptap/react": "3.31.4",
        "@tiptap/starter-kit": "3.31.4",
        "@types/node": "24.19.1",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "5.2.0",
        "axe-core": "4.13.0",
        "embla-carousel-react": "8.6.0",
        "eslint": "10.10.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.12.0",
        "jsdom": "30.1.1",
        "lucide-react": "0.577.0",
        "marked": "18.0.14",
        "pagefind": "1.5.2",
        "playwright": "1.63.0",
        "publint": "0.3.25",
        "radix-ui": "1.6.7",
        "react": "19.3.0",
        "react-day-picker": "10.0.2",
        "react-docgen-typescript": "2.4.0",
        "react-dom": "19.3.0",
        "react-resizable-panels": "4.14.2",
        "react-router": "8.4.0",
        "recharts": "3.10.1",
        "shiki": "4.5.0",
        "sonner": "2.0.8",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.0",
        "vite": "8.3.1",
        "vitest": "5.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "pnpm@10.28.2"
}
